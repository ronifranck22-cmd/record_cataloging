# ── Virtual environments ────────────────────────────────────────────────────
venv*/
.venv/

# ── Python bytecode ─────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── Streamlit secrets (NEVER commit — contains Firebase credentials) ─────────
.streamlit/secrets.toml

# ── Firebase / Google Cloud credentials ─────────────────────────────────────
*.json

# ── ALL local data files (app reads from Firestore, not CSV/xlsx) ────────────
*.csv
*.xlsx
*.xls

# ── Environment variable files ───────────────────────────────────────────────
.env
.env.*

# ── IDE & OS artifacts ───────────────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
Thumbs.db
